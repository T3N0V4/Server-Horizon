# Mundos
/world/
/world_nether/
/world_the_end/
/world*/

# Logs y crashes
/logs/
/crash-reports/
*.log

# Cachés / temporales
/cache/
/caches/
*.tmp
*.temp

# Archivos generados por Fabric / Minecraft
/libraries/
/versions/
.fabric/
fabric-server-launch.jar
/fabric-server*.jar

# Datos de jugadores / servidor
/usercache.json
/usernamecache.json
/ops.json
/whitelist.json
/banned-ips.json
/banned-players.json

# Runtime
/session.lock
*.lock

# ==============================
# MODS
# ==============================

# No subir cientos de JARs al repo
/mods/*.jar

# Pero permitir archivos auxiliares dentro de mods
!/mods/*.json
!/mods/*.txt
!/mods/*.md

